[Unit]
Description=Austin Education homework demo
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/mnt/ssd/austin-homework
Environment=HOME=/home/chris
Environment=PATH=/home/chris/.nvm/versions/node/v22.22.3/bin:/usr/local/bin:/usr/bin:/bin
Environment=NODE_ENV=development
ExecStart=/home/chris/.nvm/versions/node/v22.22.3/bin/npm run dev -- --host 127.0.0.1
Restart=on-failure
RestartSec=5
KillSignal=SIGINT
TimeoutStopSec=20
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
StandardOutput=append:/mnt/ssd/austin-homework/logs/service.log
StandardError=append:/mnt/ssd/austin-homework/logs/service.log

[Install]
WantedBy=default.target
